# MatDAO TRL Services — deploy on Render or any Node host
# Render sets PORT automatically; TRL_SERVICES_PORT for local dev only.

GEMINI_API_KEY=your_gemini_api_key_here
TRL_SERVICES_PORT=3001

# Comma-separated frontend origins (your v0/Vercel URL)
ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://your-preview.vercel.app
