# MatDAO IP Engine — deploy on Render or any Python host
# Render sets PORT automatically; use API_PORT for local dev only.

# Multi-provider embedding configuration
EMBEDDING_PROVIDER_PRIORITY=cohere,huggingface,openai
COHERE_API_KEY=your-cohere-api-key
COHERE_EMBEDDING_MODEL=embed-english-v3.0
HUGGINGFACE_API_KEY=your-huggingface-api-key
HUGGINGFACE_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
OPENAI_API_KEY=sk-your-openai-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Patent data sources
SERPAPI_KEY=your-serpapi-key

# DeepSeek API for enhanced AI analysis (recommended for detailed insights)
DEEPSEEK_API_KEY=your-deepseek-api-key

# Claude API (Anthropic) for advanced reasoning and analysis
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620
ANTHROPIC_MAX_TOKENS=4000
ANTHROPIC_TEMPERATURE=0.3

# OpenRouter API for multi-model access and fallback
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_MAX_TOKENS=4000
OPENROUTER_TEMPERATURE=0.3

# Google API (Gemini) for market analysis and technical reasoning
GOOGLE_API_KEY=your-google-api-key
GOOGLE_MODEL=gemini-1.5-pro
GOOGLE_MAX_TOKENS=4000
GOOGLE_TEMPERATURE=0.3

# Comma-separated frontend origins (your v0/Vercel URL)
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://your-preview.vercel.app

# Optional
REPORT_SIGNING_SECRET=change-me-in-production
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
API_PORT=8765

# Multi-Agent System Configuration
ENABLE_MULTI_AGENT=true
AGENT_COORDINATOR_TIMEOUT=300
AGENT_FALLBACK_TO_RULES=true
COST_MONITORING_ENABLED=true
